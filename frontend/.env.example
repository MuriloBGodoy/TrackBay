# Sem estas variaveis o app roda em MODO DEV:
# nao inicializa o Firebase e o backend (perfil dev) resolve o usuario semeado.
# Para ativar o login real com Google, copie para .env e preencha com os dados
# do seu projeto no console do Firebase (Configuracoes do projeto > Seus apps > Web).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Usuario usado no modo dev (precisa existir no seed do backend)
VITE_DEV_USER=dono@oficinatrackwheel.com.br
